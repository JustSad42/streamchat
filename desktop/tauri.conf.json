{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamChat",
  "version": "0.2.2",
  "identifier": "com.streamchat.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "script-src 'self'; object-src 'none'; base-uri 'none'", "dangerousDisableAssetCspModification": ["style-src"] }
