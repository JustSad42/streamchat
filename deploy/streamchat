#!/usr/bin/env bash
# StreamChat server helper, installed by install.sh as /usr/local/bin/streamchat.
#   streamchat status     is it running, and the addresses to use
#   streamchat key        the access key for the app
#   streamchat logs       follow the server log
#   streamchat update     download and start the newest version (runs nightly by itself)
#   streamchat restart | stop | start
#   streamchat setup      (re)do the Docker, Tailscale and nightly-update setup
#   streamchat uninstall  stop and remove StreamChat (keeps your data unless you add --purge)
set -euo pipefail

REPO="JustSad42/streamchat"
DIR="${STREAMCHAT_DIR:-/opt/streamchat}"
UNITS="${STREAMCHAT_UNITS:-/etc/systemd/system}"
COMPOSE="$DIR/docker-compose.yml"

say()  { [ "${QUIET:-}" = 1 ] || printf '\033[1;35m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "Run with sudo: sudo streamchat $1"; }
fetch() { curl -fsSL --connect-timeout 15 --max-time 120 --retry 2 -H 'User-Agent: streamchat-update' "$@" \
  || curl -4 -fsSL --connect-timeout 15 --max-time 120 --retry 2 -H 'User-Agent: streamchat-update' "$@"; }
dc() { docker compose -f "$COMPOSE" -p streamchat "$@"; }

# Helpers end in "|| true": under pipefail a grep with no match would otherwise end the script silently.
ts_dns() { tailscale status --json 2>/dev/null | grep -o '"DNSName": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"/\1/; s/\.$//' || true; }
ts_used_ports() { tailscale serve status --json 2>/dev/null | tr -d ' \n' | grep -o '"[0-9]\{2,5\}":{"\(HTTPS\|HTTP\|TCPForward\)"' | grep -o '^"[0-9]*"' | tr -d '"' || true; }
ts_port_for() { # which HTTPS port on the tailnet already forwards to this local port
  tailscale serve status --json 2>/dev/null | tr -d ' \n' | grep -o "\"[^\"]*:[0-9]*\":{\"Handlers\":{\"/\":{\"Proxy\":\"http://127.0.0.1:$1\"" | head -1 | sed 's/^"[^:]*:\([0-9]*\)".*/\1/' || true
}
read_state() { cat "$DIR/state" 2>/dev/null || true; }
state_get() { read_state | grep "^$1=" | head -1 | cut -d= -f2- || true; }
state_set() { touch "$DIR/state"; grep -v "^$1=" "$DIR/state" > "$DIR/state.tmp" || true; echo "$1=$2" >> "$DIR/state.tmp"; mv "$DIR/state.tmp" "$DIR/state"; }

access_key() { grep -o '"accessKey": *"[^"]*"' "$DIR/data/secrets.json" 2>/dev/null | sed 's/.*"\([^"]*\)"$/\1/' || true; }

wait_healthy() {
  for _ in $(seq 1 60); do
    curl -fsS http://127.0.0.1:8787/health >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

write_compose() {
  local hook="$1"
  cat > "$COMPOSE" <<EOF
# Written by "streamchat setup". The ports are bound to 127.0.0.1 only; Tailscale makes the app
# reachable on your tailnet and only the Kick webhook port public.
services:
  streamchat:
    build: ./app
    image: streamchat-local
    restart: unless-stopped
    ports:
      - "127.0.0.1:8787:8787"
      - "127.0.0.1:8788:8788"
    environment:
      STREAMCHAT_INSTALL: script
      STREAMCHAT_KICK_WEBHOOK_URL: "$hook"
    volumes:
      - ./data:/data
EOF
}

cmd_setup() {
  need_root setup
  mkdir -p "$DIR/data"
  [ -d "$DIR/app" ] || die "StreamChat isn't downloaded yet. Run install.sh first."

  # --- Tailscale: app on the tailnet (private), Kick webhooks via Funnel (public)
  local dns app_port hook_port hook_url=""
  dns=$(ts_dns)
  if [ -z "$dns" ]; then
    warn "Tailscale isn't connected, so the app will only be reachable from this server. Run 'tailscale up' and then 'sudo streamchat setup'."
  else
    app_port=$(ts_port_for 8787)
    if [ -z "$app_port" ]; then
      app_port=443
      if ts_used_ports | grep -qx 443; then app_port=8787; fi
      say "Making StreamChat reachable on your tailnet (port $app_port)"
      tailscale serve --bg --https=$app_port http://127.0.0.1:8787 >/dev/null
    fi
    state_set app_url "https://$dns$([ "$app_port" = 443 ] || echo ":$app_port")"

    hook_port=$(ts_port_for 8788)
    if [ -z "$hook_port" ]; then
      for p in 8443 10000; do ts_used_ports | grep -qx $p || { hook_port=$p; break; }; done
      if [ -n "$hook_port" ]; then
        say "Making the Kick webhook port public with Tailscale Funnel (port $hook_port)"
        say "If Tailscale prints a link, open it and allow Funnel for this tailnet."
        if ! timeout 180 tailscale funnel --bg --https=$hook_port http://127.0.0.1:8788; then
          warn "Funnel isn't on yet. Allow it in the Tailscale admin console, then run: sudo streamchat setup"
          hook_port=""
        fi
      else
        warn "Tailscale Funnel ports 8443 and 10000 are both taken; Kick webhooks need one of them."
      fi
    fi
    [ -n "$hook_port" ] && hook_url="https://$dns$([ "$hook_port" = 443 ] || echo ":$hook_port")/webhooks/kick"
    state_set kick_webhook "$hook_url"
  fi

  write_compose "$hook_url"
  say "Starting StreamChat"
  dc up -d --build --remove-orphans
  wait_healthy || { dc logs --tail 40; die "StreamChat didn't start. The log is above."; }

  # --- nightly updates
  cat > $UNITS/streamchat-update.service <<EOF
[Unit]
Description=Update StreamChat
After=network-online.target docker.service
[Service]
Type=oneshot
Environment=QUIET=1
ExecStart=/usr/local/bin/streamchat update
EOF
  cat > $UNITS/streamchat-update.timer <<EOF
[Unit]
Description=Update StreamChat every night
[Timer]
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=30m
Persistent=true
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now streamchat-update.timer >/dev/null 2>&1 || warn "Couldn't turn on nightly updates (systemd timer)."

  cmd_status
}

cmd_status() {
  local url key hook
  url=$(state_get app_url); key=$(access_key); hook=$(state_get kick_webhook)
  if curl -fsS http://127.0.0.1:8787/health >/dev/null 2>&1; then
    local v; v=$(curl -fsS http://127.0.0.1:8787/health | grep -o '"version":"[^"]*"' | cut -d'"' -f4 || true)
    printf '\n\033[1;32mStreamChat %s is running.\033[0m\n\n' "$v"
  else
    printf '\n\033[1;31mStreamChat is not running.\033[0m Try: sudo streamchat logs\n\n'
  fi
  if [ -n "$url" ]; then
    echo "  Open the app (any device on your tailnet):"
    echo "    $url/app?key=$key"
    echo
    echo "  Desktop app: tray icon → Change connection… → On my server"
    echo "    Address:    $url"
    echo "    Access key: $key"
  else
    echo "  Access key: $key   (app on http://127.0.0.1:8787 on this server only)"
  fi
  echo
  if [ -n "$hook" ]; then
    echo "  Kick webhook URL (paste into your Kick app):"
    echo "    $hook"
  else
    echo "  Kick webhook URL: not set up yet (needs Tailscale Funnel). Run: sudo streamchat setup"
  fi
  echo
  echo "  OBS overlay links: open the app → Overlay. Your PC needs Tailscale running for OBS to load them."
  echo "  Updates install every night. Update now: sudo streamchat update"
  echo
}

cmd_update() {
  need_root update
  local url current latest tag tmp
  tag=$(fetch "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true)
  if [ -z "$tag" ]; then
    tag=$(fetch -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest" 2>/dev/null | sed -n 's#.*/tag/\(v[^/]*\)$#\1#p' || true)
  fi
  [ -n "$tag" ] || die "Couldn't reach GitHub. Check: curl -I https://github.com"
  latest=${tag#v}
  current=$(grep -o '"version": *"[^"]*"' "$DIR/app/server/package.json" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/' || true)
  if [ -n "$latest" ] && [ "$latest" = "$current" ] && [ "${1:-}" != "--force" ]; then
    say "Already on the newest version ($current)."
    return 0
  fi
  url="https://github.com/$REPO/releases/download/$tag/streamchat-server-$latest.tar.gz"
  say "Updating StreamChat ${current:-?} → $latest"
  tmp=$(mktemp -d)
  fetch "$url" -o "$tmp/server.tar.gz" || die "The download failed: $url"
  rm -rf "$DIR/app.new" && mkdir -p "$DIR/app.new"
  tar -xzf "$tmp/server.tar.gz" -C "$DIR/app.new"
  rm -rf "$tmp"
  rm -rf "$DIR/app.old" && { [ -d "$DIR/app" ] && mv "$DIR/app" "$DIR/app.old" || true; } && mv "$DIR/app.new" "$DIR/app"
  install -m 755 "$DIR/app/deploy/streamchat" /usr/local/bin/streamchat
  if dc up -d --build --remove-orphans && wait_healthy; then
    rm -rf "$DIR/app.old"
    docker image prune -f >/dev/null 2>&1 || true
    say "StreamChat $latest is running."
  else
    warn "The new version didn't start; going back to ${current:-the previous one}."
    rm -rf "$DIR/app" && mv "$DIR/app.old" "$DIR/app"
    dc up -d --build
    exit 1
  fi
}

cmd_uninstall() {
  need_root uninstall
  dc down 2>/dev/null || true
  systemctl disable --now streamchat-update.timer 2>/dev/null || true
  rm -f $UNITS/streamchat-update.{service,timer}
  local p
  p=$(ts_port_for 8787); [ -n "$p" ] && tailscale serve --https=$p off >/dev/null 2>&1 || true
  p=$(ts_port_for 8788); [ -n "$p" ] && tailscale funnel --https=$p off >/dev/null 2>&1 || true
  if [ "${1:-}" = "--purge" ]; then rm -rf "$DIR"; say "Removed StreamChat and its data."
  else rm -rf "$DIR/app" "$COMPOSE"; say "Removed StreamChat. Your settings and chat logs are still in $DIR/data (delete with --purge)."; fi
  rm -f /usr/local/bin/streamchat
}

case "${1:-status}" in
  setup) cmd_setup ;;
  status|url) cmd_status ;;
  key) access_key ;;
  logs) dc logs -f --tail 100 ;;
  update) shift; cmd_update "${1:-}" ;;
  restart) need_root restart; dc restart ;;
  stop) need_root stop; dc stop ;;
  start) need_root start; dc up -d ;;
  uninstall) shift; cmd_uninstall "${1:-}" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
